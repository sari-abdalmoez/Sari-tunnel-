<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/sari_background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SariTunnelAfrica" android:textColor="@color/sari_text" android:textSize="25sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="PRIVATE CONNECTION · SIMPLE CONTROL" android:textColor="@color/sari_cyan" android:textSize="10sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="CHOOSE CONNECTION" android:textColor="@color/sari_muted" android:textSize="11sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/openVpnButton" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="OPENVPN&#10;Auto server" android:textSize="11sp" android:textStyle="bold" app:backgroundTint="@color/sari_blue" app:cornerRadius="14dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/vlessServersButton" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginHorizontal="5dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="VLESS&#10;Xray" android:textSize="11sp" android:textStyle="bold" app:backgroundTint="@color/sari_surface_alt" app:cornerRadius="14dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/torButton" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginStart="5dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="TOR VPN&#10;Privacy" android:textSize="11sp" android:textStyle="bold" app:backgroundTint="@color/sari_surface_alt" app:cornerRadius="14dp"/>
</LinearLayout>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/sari_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="#283A53" app:strokeWidth="1dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/statusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DISCONNECTED" android:textColor="@color/sari_text" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/statusMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Choose a connection method." android:textColor="@color/sari_muted" android:textSize="12sp"/>
<TextView android:id="@+id/elapsedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="monospace" android:gravity="center" android:text="00:00:00" android:textColor="@color/sari_text" android:textSize="29sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="CONNECT" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@color/sari_cyan" app:cornerRadius="15dp"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="OPENVPN SERVERS" android:textColor="@color/sari_text" android:textSize="13sp" android:textStyle="bold"/><com.google.android.material.button.MaterialButton android:id="@+id/stableServerButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="STABLE: ON" android:textSize="10sp" app:cornerRadius="10dp" app:backgroundTint="@color/sari_blue"/><com.google.android.material.button.MaterialButton android:id="@+id/refreshServersButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Refresh" android:textColor="@color/sari_cyan"/></LinearLayout>
<ProgressBar android:id="@+id/serverProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:indeterminate="true" android:visibility="gone"/>
<LinearLayout android:id="@+id/serverListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/sari_surface" app:cardCornerRadius="14dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:id="@+id/serverText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No server selected" android:textColor="@color/sari_text" android:textStyle="bold"/><TextView android:id="@+id/protocolText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Select a protocol above" android:textColor="@color/sari_muted" android:textSize="11sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal"><TextView android:id="@+id/downloadText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↓ Download —" android:textColor="@color/sari_muted" android:textSize="12sp"/><TextView android:id="@+id/uploadText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="↑ Upload —" android:textColor="@color/sari_muted" android:textSize="12sp"/></LinearLayout>
<TextView android:id="@+id/usageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Live traffic statistics depend on the selected engine." android:textColor="@color/sari_muted" android:textSize="10sp"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/diagToggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:text="Show connection log" android:textColor="@color/sari_muted"/>
<ScrollView android:id="@+id/diagPanel" android:layout_width="match_parent" android:layout_height="150dp" android:background="@color/sari_surface" android:padding="10dp" android:visibility="gone"><TextView android:id="@+id/diagText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/sari_muted" android:textSize="10sp"/></ScrollView>
<TextView android:id="@+id/noteText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tor VPN requires the official Tor VPN app. Public servers can be slow or unavailable and do not make mobile data free." android:textColor="@color/sari_muted" android:textSize="11sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/advancedButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:text="Advanced settings" android:textColor="@color/sari_cyan"/>
</LinearLayout></ScrollView>
