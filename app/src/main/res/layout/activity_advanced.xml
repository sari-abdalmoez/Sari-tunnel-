<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sari_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced settings"
            android:textColor="@color/sari_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set an HTTPS JSON backup feed or paste your own single-file OpenVPN profile. Profile text is stored encrypted on this device."
            android:textColor="@color/sari_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="HTTPS JSON backup feed URL"
            android:textColor="@color/sari_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/feedInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.org/servers.json"
            android:inputType="textUri"
            android:textColor="@color/sari_text"
            android:textColorHint="@color/sari_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Custom OpenVPN profile (.ovpn) — optional"
            android:textColor="@color/sari_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/configInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="client&#10;remote vpn.example.com 1194 udp&#10;..."
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="10"
            android:textColor="@color/sari_text"
            android:textColorHint="@color/sari_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="Save settings"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear custom profile and feed"
            android:textColor="@color/sari_amber" />
    </LinearLayout>
</ScrollView>
